# REPSI Environment Variables — Copy to .env.local for development

# ─── Database ───────────────────────────────────────────────────────
DATABASE_URL=postgresql://repsi:repsi@localhost:5432/repsi
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ─── API (Backend) ──────────────────────────────────────────────────
SECRET_KEY=change-me-in-production-use-a-long-random-string
JWT_SECRET=change-me-in-production-use-another-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── Web Frontend ───────────────────────────────────────────────────
# Public env vars (exposed to browser) must be prefixed NEXT_PUBLIC_
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Ports ──────────────────────────────────────────────────────────
WEB_PORT=3000
API_PORT=8000
DB_PORT=5432

# ─── Environment ────────────────────────────────────────────────────
NODE_ENV=development
PYTHON_ENV=development

# ─── Future: Email ──────────────────────────────────────────────────
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM=noreply@repsi.app

