# ==============================================================================
# REPSI Environment Variables Template
# Copy this file to .env (or .env.local) and adjust values for your environment.
# ==============================================================================

# ─── Environment & Runtime ──────────────────────────────────────────────────
NODE_ENV=development
PYTHON_ENV=development
ENVIRONMENT=development
DEBUG=true

# ─── Ports ──────────────────────────────────────────────────────────────────
WEB_PORT=3000
API_PORT=8000
DB_PORT=5432

# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://repsi:repsi@localhost:5432/repsi
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ─── API Security & JWT Authentication ──────────────────────────────────────
SECRET_KEY=change-me-in-production-use-a-long-random-string
JWT_SECRET=change-me-in-production-use-another-long-random-string
ALGORITHM=HS256
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── CORS & Domain Routing ──────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","https://repsi.app"]

# ─── Web Frontend (Next.js Public Variables) ────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Email Dispatch (SMTP / Gmail App Password) ──────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@repsi.app

# ─── Cashfree Payments Gateway ──────────────────────────────────────────────
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=TEST
NEXT_PUBLIC_CASHFREE_ENV=sandbox

# ─── Google OAuth & Analytics ───────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GA_ID=
