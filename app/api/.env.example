# ==============================================================================
# REPSI Backend Environment Template (FastAPI)
# Copy to app/api/.env
# ==============================================================================

# ─── Environment & Runtime ──────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
API_PORT=8000

# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://repsi:repsi@localhost:5432/repsi
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ─── API Security & JWT Authentication ──────────────────────────────────────
SECRET_KEY=change-me-in-production-use-a-long-random-string
JWT_SECRET=change-me-in-production-use-another-long-random-string
ALGORITHM=HS256
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── CORS & Domain Routing ──────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","https://repsi.app"]

# ─── Email Dispatch (SMTP / Gmail App Password) ──────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@repsi.app
OTP_EXPIRE_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60

# ─── Cashfree Payments Gateway ──────────────────────────────────────────────
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=TEST

# ─── Google OAuth Server Verification ────────────────────────────────────────
GOOGLE_CLIENT_SECRET=
